# ──────────────────────────────────────────────────────────────
# AgentBot — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These variables override values from appsettings.json and
# Config/appsettings.json (environment vars have highest priority).
#
# Use "__" (double underscore) as section separator:
#   Bots__Telegram__ApiToken  →  maps to  Bots:Telegram:ApiToken
# ──────────────────────────────────────────────────────────────

# ─── Telegram Bot ─────────────────────────────────────────────
Bots__Telegram__ApiToken=

# ─── AI Agent ─────────────────────────────────────────────────
# Provider: Gemini, Grok, or OpenAI
AiAgent__Provider=Gemini
AiAgent__ApiKey=
AiAgent__Model=gemini-2.5-flash

# ─── Weather (OpenWeatherMap) ─────────────────────────────────
WeatherApiKey=

# ─── Security ─────────────────────────────────────────────────
Security__AdminPassword=
